DATABASE_URL="postgresql://psiko:psiko1234@postgres:5432/psikodb"
DIRECT_URL="postgresql://psiko:psiko1234@postgres:5432/psikodb"

JWT_ACCESS_SECRET="change-me-strong-secret-here"
JWT_ACCESS_EXPIRES="1h"
JWT_REFRESH_SECRET="change-me-strong-secret-here"
JWT_REFRESH_EXPIRES="7d"

PORT="4000"
FRONTEND_URL="http://localhost:3000"

BREVO_API_KEY=""
BREVO_SENDER_NAME="Psiko Danışmanlık"
BREVO_SENDER_EMAIL="noreply@psikoplatform.com"
# Bulten abonelerinin eklendigi Brevo liste ID'si (bos: bulten kaydi atlanir)
BREVO_NEWSLETTER_LIST_ID=""
# Yeni iletisim formu / uzman basvurusu bildirimlerinin gidecegi adres
ADMIN_NOTIFICATION_EMAIL="admin@psikoplatform.com"

# MinIO (S3-uyumlu dosya depolama)
MINIO_ENDPOINT="psiko_minio"
MINIO_PORT="9000"
MINIO_ROOT_USER="psikoadmin"
MINIO_ROOT_PASSWORD="change-me-strong-password"
MINIO_BUCKET="psiko-uploads"
MINIO_PUBLIC_URL="http://YOUR_VPS_IP:9000"

# Meta (WhatsApp/Instagram) webhook imza doğrulama. Meta → App Settings →
# Basic → App Secret. Birden fazla Meta App'ten webhook alınıyorsa virgülle
# ayrılmış birden fazla secret girilebilir. Boş bırakılırsa webhook
# istekleri reddedilir (fail closed).
META_APP_SECRET=""
# Meta webhook GET doğrulama akışı (hub.verify_token). Meta Developer
# Console → WhatsApp/Instagram → Webhooks kurulumunda bu değeri birebir
# girersin.
META_VERIFY_TOKEN=""

# Asistan (Elif) - hibrit RAG + cevap üretimi. ASSISTANT_ENABLED=false iken
# webhook yalnızca mesajı kaydeder; LLM çağrılmaz, Meta'ya yanıt gönderilmez.
ASSISTANT_ENABLED=false
# OpenAI anahtarı eksikse asistan ilgili adımı atlar ve personele devreder.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# OpenAI sohbet çağrısı zaman aşımı (ms). Embedding çağrısı sabit 15 sn.
OPENAI_TIMEOUT_MS="30000"
# Bilgi bankası benzerlik eşiği (cosine, 0-1).
ASSISTANT_SIMILARITY_THRESHOLD="0.40"
# LLM'e giden son mesaj sayısı.
ASSISTANT_HISTORY_LIMIT="20"
# Art arda gelen mesajları tek cevapta toplama süresi (ms). Her yeni mesaj süreyi baştan başlatır. 0 ise beklemez.
ASSISTANT_DEBOUNCE_MS="5000"
# Bir konuşmada son 60 dakikada en fazla bu kadar bot cevabı. Aşılırsa konuşma personele devredilir.
ASSISTANT_MAX_REPLIES_PER_HOUR="20"
# Instagram için tek mesajın en fazla karakter sayısı. Daha uzun cevaplar bu sınırda parçalanır (Meta sınırı doğrulanmadı).
INSTAGRAM_MAX_CHARS="1000"
# Kriz kilidi süresi (gün). Kullanımı ve varsayılanı webhook tarafında tanımlanır; ayarlanmazsa kod varsayılanı geçerlidir.
# ASSISTANT_CRISIS_LOCK_DAYS=<gün sayısı>
# Fiyat kaynağı: prompt (prompt.md tablosu) | packages (Package tablosu)
ELIF_PRICE_SOURCE="prompt"
# Meta Graph API sürümü ve gönderim kimlikleri / erişim token'ları.
META_GRAPH_VERSION="v21.0"
# Meta gönderim zaman aşımı (ms).
META_TIMEOUT_MS="10000"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""
INSTAGRAM_ACCESS_TOKEN=""
